# notion-mirror — environment configuration
#
# Copy this file to `.env` (gitignored) and fill in your values:
#     cp .env.example .env
#
# Precedence: CLI flags > real environment variables > this file > defaults.

# REQUIRED — Notion token.
# Recommended: a Personal Access Token (PAT) created at
#   https://www.notion.so/developers/tokens
# with the "Notion API" capability. A PAT acts with your user permissions and
# sees the whole workspace, without sharing pages with an integration.
# It expires after one year at most: create a new one and update this value.
# Internal integration tokens (secret_...) also work, but you must manually
# share every top-level page with the integration.
NOTION_TOKEN=

# OPTIONAL — Directory of the mirror inside the repository (default: backup).
#NOTION_BACKUP_DIR=backup

# OPTIONAL — Comment policy: always | on-change | off (default: always).
# Comments do NOT bump a page's last_edited_time, so "always" (one request
# per page) is the only mode guaranteed to capture every new comment.
# "on-change" only fetches them when the page itself changed (faster).
#NOTION_COMMENTS=always

# OPTIONAL — Maximum requests per second against the Notion API (default: 2.5).
# Notion personal plans allow roughly 3 req/s; lower this if you see 429s.
#NOTION_REQUESTS_PER_SECOND=2.5
